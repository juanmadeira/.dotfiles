[global]
width = 325
progress_bar_min_width = 250
progress_bar_max_width = 300
offset = 16x16
padding = 12
horizontal_padding = 12
line_height = 2
corner_radius = 10

frame_width = 1
frame_color = "#2d5a27cc"
separator_color = frame
font = JetBrainsMono Nerd Font 10

[urgency_low]
background = "#1b2419cc"
foreground = "#d8e6d3"

[urgency_normal]
background = "#1b2419cc"
foreground = "#d8e6d3"

[urgency_critical]
frame_color = "#b84a4acc"
background = "#1b2419cc"
foreground = "#ffffff"
